# PostgreSQL connection string used by the app, migrations and seeds.
DATABASE_URL=postgres://attendance:attendance@localhost:55432/attendance

# Shared demo account created by the seed script.
DEMO_EMAIL=demo@attendance.app
DEMO_PASSWORD=demo12345
DEMO_NAME=Demo Teacher

# Reporting time zone used for "today" on the dashboard and attendance sheet.
APP_TIMEZONE=Asia/Jakarta

# Set to false to skip demo seeding during a deployment release step.
SEED_DEMO=true
